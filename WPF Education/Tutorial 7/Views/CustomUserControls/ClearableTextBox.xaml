<UserControl x:Class="Tutorial_7.Views.CustomUserControls.ClearableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tutorial_7.Views.CustomUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250">
    <Grid>
        <TextBox x:Name="customTxtInputControl" VerticalContentAlignment="Center" 
                 FontSize="15" Background="Transparent" TextChanged="customTxtInputControl_TextChanged"></TextBox>
        <TextBlock x:Name="textBoxPlaceholder" FontSize="16"
                   FontWeight="Light" Foreground="DarkGray" VerticalAlignment="Center"
                   Text="{Binding Placeholder}"
                   Margin="5,0,0,0" Panel.ZIndex="-1" Background="White"></TextBlock>
        <!--Foreground controls the color of the text dev note:-->
        <Button x:Name="btnCLear" Width="30" HorizontalAlignment="Right" 
                Content="X" Background="Transparent" Foreground="LightGray"
                BorderThickness="0" Click="btnCLear_Click">
        </Button>
    </Grid>
</UserControl>
