<UserControl x:Class="Tutorial_6.View.CustomUserControls.CustomMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tutorial_6.View.CustomUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">
            
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Background="LightGray">
            <MenuItem Header="_File" FontSize="16">
                <MenuItem Header="_New"/>
                <MenuItem Header="_Open"/>
                <MenuItem Header="_Save"/>
                <Separator/>
                <MenuItem Name="MenuItemExit" Header="_Exit" />
            </MenuItem>
            <MenuItem Header="Edit" FontSize="16">
                <MenuItem Header="Edit the Fuck out of it"/>
            </MenuItem>
            <!-- SEARCHTEST_12345 -->
        </Menu>
    </Grid>
</UserControl>
